# Copy this file to ".env" (same folder as pom.xml) and fill in your values.

# --- MySQL ---
# Local: create nothing by hand, the database "blogapp" is created automatically.
DB_URL=jdbc:mysql://localhost:3306/blogapp?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
# Cloud MySQL (Aiven / Railway / etc.) usually needs SSL, e.g.:
# DB_URL=jdbc:mysql://HOST:PORT/DBNAME?sslMode=REQUIRED&serverTimezone=UTC

# Any long random string (used to sign login tokens)
SECRET_KEY=change-this-to-a-long-random-string

PORT=4000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Browsers allowed to call the API (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://blog-app-ivdh.vercel.app

# Optional: creates an ADMIN login on first start (there is no admin sign-up page)
ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD=admin123

# Cookie flags.
# Local (http://localhost):  COOKIE_SECURE=false  COOKIE_SAME_SITE=Lax
# Deployed (https, frontend and backend on different domains):  COOKIE_SECURE=true  COOKIE_SAME_SITE=None
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
